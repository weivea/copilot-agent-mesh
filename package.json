{
  "name": "copilot-agent-mesh",
  "displayName": "Copilot Agent Mesh",
  "description": "Delegate GitHub Copilot coding tasks across trusted VS Code workspaces and devices.",
  "version": "0.0.1",
  "publisher": "weivea",
  "repository": {
    "type": "git",
    "url": "https://github.com/weivea/copilot-agent-mesh.git"
  },
  "homepage": "https://github.com/weivea/copilot-agent-mesh#readme",
  "bugs": {
    "url": "https://github.com/weivea/copilot-agent-mesh/issues"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "agent",
    "multi-device",
    "remote-development"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Copilot Agent Mesh can delegate coding tasks that modify files and run commands."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Remote task execution requires local filesystem-backed workspaces."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotAgentMesh",
          "title": "Copilot Agent Mesh",
          "icon": "media/agent-mesh.svg"
        }
      ]
    },
    "views": {
      "copilotAgentMesh": [
        {
          "id": "copilotAgentMesh.dashboard",
          "name": "Dashboard",
          "type": "webview",
          "contextualTitle": "Copilot Agent Mesh"
        }
      ]
    },
    "commands": [
      {
        "command": "copilotAgentMesh.configureDevice",
        "title": "Configure Device Name",
        "category": "Copilot Agent Mesh",
        "icon": "$(gear)"
      },
      {
        "command": "copilotAgentMesh.refreshDashboard",
        "title": "Refresh Dashboard",
        "category": "Copilot Agent Mesh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilotAgentMesh.configureDevice",
          "when": "view == copilotAgentMesh.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "copilotAgentMesh.refreshDashboard",
          "when": "view == copilotAgentMesh.dashboard",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Agent Mesh",
      "properties": {
        "copilotAgentMesh.deviceName": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The name used to identify this device to trusted peers."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src shared",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
