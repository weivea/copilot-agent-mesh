{
  "name": "copilot-agent-mesh",
  "displayName": "Copilot Agent Mesh",
  "description": "Delegate GitHub Copilot coding tasks across trusted VS Code workspaces and devices.",
  "version": "0.0.1",
  "publisher": "weivea",
  "repository": {
    "type": "git",
    "url": "https://github.com/weivea/copilot-agent-mesh.git"
  },
  "homepage": "https://github.com/weivea/copilot-agent-mesh#readme",
  "bugs": {
    "url": "https://github.com/weivea/copilot-agent-mesh/issues"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "agent",
    "multi-device",
    "remote-development"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Copilot Agent Mesh can delegate coding tasks that modify files and run commands."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Remote task execution requires local filesystem-backed workspaces."
    }
  },
  "contributes": {
    "languageModelTools": [
      {
        "name": "mesh_spike_echo",
        "displayName": "Mesh Spike Echo",
        "toolReferenceName": "meshSpikeEcho",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Starts a local simulated asynchronous mesh task and returns a structured pending result after a configurable acknowledgement delay. Use only to validate the Copilot Agent Mesh tool workflow.",
        "userDescription": "Validate the asynchronous Copilot Agent Mesh tool workflow without calling a model or accessing workspace files.",
        "tags": [
          "copilot-agent-mesh",
          "spike"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "A short, non-sensitive message for the spike tool to echo."
            },
            "delaySeconds": {
              "type": "number",
              "enum": [
                5,
                15,
                30
              ],
              "default": 5,
              "description": "Simulated worker acknowledgement delay in seconds."
            },
            "confirmationBudgetSeconds": {
              "type": "number",
              "enum": [
                5,
                15,
                30
              ],
              "default": 15,
              "description": "Application-level acknowledgement wait budget in seconds."
            },
            "delegationRequestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Optional stable request ID used to reconcile a retry without starting a second task."
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotAgentMesh",
          "title": "Copilot Agent Mesh",
          "icon": "media/agent-mesh.svg"
        }
      ]
    },
    "views": {
      "copilotAgentMesh": [
        {
          "id": "copilotAgentMesh.dashboard",
          "name": "Dashboard",
          "type": "webview",
          "contextualTitle": "Copilot Agent Mesh"
        }
      ]
    },
    "commands": [
      {
        "command": "copilotAgentMesh.configureDevice",
        "title": "Configure Device Name",
        "category": "Copilot Agent Mesh",
        "icon": "$(gear)"
      },
      {
        "command": "copilotAgentMesh.refreshDashboard",
        "title": "Refresh Dashboard",
        "category": "Copilot Agent Mesh",
        "icon": "$(refresh)"
      },
      {
        "command": "copilotAgentMesh.runAgentHostTask",
        "title": "Run Agent Host Task",
        "category": "Copilot Agent Mesh"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilotAgentMesh.configureDevice",
          "when": "view == copilotAgentMesh.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "copilotAgentMesh.refreshDashboard",
          "when": "view == copilotAgentMesh.dashboard",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Agent Mesh",
      "properties": {
        "copilotAgentMesh.deviceName": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The name used to identify this device to trusted peers."
        },
        "copilotAgentMesh.codePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Optional VS Code CLI path used by the experimental Agent Host runtime."
        },
        "copilotAgentMesh.experimental.agentHost": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Enable the real Agent Host/AHP runtime. This may consume Copilot quota."
        },
        "copilotAgentMesh.experimental.authenticationProviders": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "providerId": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "providerId",
              "scopes"
            ],
            "additionalProperties": false
          },
          "markdownDescription": "Maps an AHP protected-resource or authorization-server URL to a VS Code authentication provider ID and exact scopes. No provider or scope is inferred."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src shared",
    "test:unit": "npm run compile-tests && node --test out/src/unitTest/*.test.js out/src/test/unit/*.test.js",
    "test:component": "npm run compile-tests && node --test out/src/componentTest/*.test.js",
    "test:dev-tunnel-real": "npm run compile-tests && node --test out/src/integrationTest/devTunnel.real.test.js",
    "test:extension": "npm run compile-tests && npm run compile && vscode-test",
    "test": "npm run test:unit && npm run test:component && npm run test:extension",
    "spike:dev-tunnel": "npm run test:dev-tunnel-real",
    "test:agent-host-auth-e2e": "npm run compile-tests && node out/src/e2e/agentHost.e2e.js auth-boundary",
    "test:agent-host-success-e2e": "npm run compile-tests && node out/src/e2e/agentHost.e2e.js success-turn",
    "spike:agent-host": "npm run compile-tests && node out/src/spikes/agentHostSpike.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@types/ws": "8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "file:vendor/microsoft-agent-host-protocol-0.8.0.tgz",
    "zod": "4.1.11",
    "ws": "8.21.3"
  }
}
